        private void calculateButton_Click(object sender, EventArgs e, double kmpl)
        {
            double km; // 儲存行駛公里數
            double liters; // 儲存耗油量
            double kmpl; // 儲存每公升行駛公里數

            if (!double.TryParse(milesTextBox.Text, out km) || km <= 0)
            {
                MessageBox.Show("請輸入大於 0 的行駛公里數。", "輸入錯誤", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                milesTextBox.Focus();
                return;
            }

            if (!double.TryParse(gallonsTextBox.Text, out liters) || liters <= 0)
            {
                MessageBox.Show("請輸入大於 0 的耗油量。", "輸入錯誤", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                gallonsTextBox.Focus();
                return;
            }

            kmpl = km / liters;
            mpgLabel.Text = kmpl.ToString("F2"); // 顯示每公升行駛公里數，格式為小數點後兩位

        }

